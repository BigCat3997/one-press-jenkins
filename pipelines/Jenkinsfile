pipeline {
    agent { label 'debian-docker-agent1' }

    parameters {
        string(name: 'gitBranch', defaultValue: 'main', description: 'Target branch.')
    }

    environment {
        ONE_PRESS_RESOURCES_REPO_URL = 'https://github.com/BigCat3997/one-press-resources'
        ONE_PRESS_BASH_REPO_URL = 'https://github.com/BigCat3997/one-press-bash'
        MAVEN_SIMPLE_API_REPO_URL = 'https://github.com/BigCat3997/maven-simple-api'
    }

    stages {
        stage('Bootstrap') {
            steps {
                script {
                    dir('one-press-resources') {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'main']],
                            userRemoteConfigs: [[url: env.ONE_PRESS_RESOURCES_REPO_URL]]
                        ])
                    }
                    dir('one-press-bash') {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'feature/init-phrase']],
                            userRemoteConfigs: [[url: env.ONE_PRESS_BASH_REPO_URL]]
                        ])
                    }
                    // dir('maven-simple-api') {
                    //     checkout([
                    //         $class: 'GitSCM',
                    //         branches: [[name: "${params.gitBranch}"]],
                    //         userRemoteConfigs: [[url: env.MAVEN_SIMPLE_API_REPO_URL]]
                    //     ])
                    // }

                    withEnv([
                        'STAGE_NAME=BOOTSTRAP',
                        "BOOTSTRAP_BASE_DIR=${env.WORKSPACE}",
                    ]) {
                        dir('one-press-bash') {
                            sh 'env'
                            sh './src/functions/initialize_workspace.sh'
                        }
                    }

                    withEnv([
                        "APP_SOURCE_BASE_DIR=${env.WORKSPACE}/bootstrap_section",
                        "GIT_URL=${env.MAVEN_SIMPLE_API_REPO_URL}",
                        "GIT_BRANCH=${params.gitBranch}",
                    ]) {
                        dir('one-press-bash') {
                            sh 'env'
                            sh './src/functions/git_clone.sh'
                        }
                    }

                    withEnv([
                        "PUBLISH_PREFIX_PATH=${env.WORKSPACE}/bootstrap_section",
                        "GIT_URL=${env.MAVEN_SIMPLE_API_REPO_URL}",
                        "PIPELINE_NAME=${env.JOB_NAME}",
                        "BUILD_NUMBER=${env.BUILD_NUMBER}",
                    ]) {
                        dir('one-press-bash') {
                            // sh "chmod +x ${env.PUBLISH_PREFIX_PATH}/.env"
                            // sh "${env.PUBLISH_PREFIX_PATH}/.env"
                            sh '''
                            #!/bin/bash
                            set -e
                            ./src/functions/write_diary.sh'
                            chmod +x ${env.PUBLISH_PREFIX_PATH}/.env
                            ${env.PUBLISH_PREFIX_PATH}/.env
                            '''
                        }
                    }

                    archiveArtifacts artifacts: "bootstrap_section/publish.json", fingerprint: true
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    withEnv([
                        'STAGE_NAME=BUILD',
                        "BOOTSTRAP_BASE_DIR=${env.WORKSPACE}",
                    ]) {
                        dir('one-press-bash') {
                            sh './src/functions/initialize_workspace.sh'
                        }
                    }
                }
            }
        }
    }
}
