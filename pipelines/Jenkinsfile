pipeline {
    agent { label 'debian-docker-agent1' }

    parameters {
        string(name: 'gitBranch', defaultValue: 'main', description: 'Target branch.')
    }

    environment {
        ONE_PRESS_RESOURCES_REPO_URL = 'https://github.com/BigCat3997/one-press-resources'
        ONE_PRESS_BASH_REPO_URL = 'https://github.com/BigCat3997/one-press-bash'
        MAVEN_SIMPLE_API_REPO_URL = 'https://github.com/BigCat3997/maven-simple-api'
        SCRIPTS_WORK_DIR = "${env.WORKSPACE}/one-press-bash"
        GLOBAL_ENV_VAR_DIR = "${env.WORKSPACE}"
    }

    stages {
        stage('Bootstrap') {
            steps {
                script {
                    dir('one-press-resources') {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'main']],
                            userRemoteConfigs: [[url: env.ONE_PRESS_RESOURCES_REPO_URL]]
                        ])
                    }
                    dir('one-press-bash') {
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: 'feature/init-phrase']],
                            userRemoteConfigs: [[url: env.ONE_PRESS_BASH_REPO_URL]]
                        ])
                    }

                    withEnv([
                        'STAGE_NAME=BOOTSTRAP',
                        "BOOTSTRAP_BASE_DIR=${env.WORKSPACE}",
                    ]) {
                        dir('one-press-bash') {
                            sh './src/functions/initialize_workspace.sh'
                        }
                    }

                    withEnv([
                        "APP_SOURCE_BASE_DIR=${env.WORKSPACE}",
                        "GIT_URL=${env.MAVEN_SIMPLE_API_REPO_URL}",
                        "GIT_BRANCH=${params.gitBranch}",
                    ]) {
                        dir('one-press-bash') {
                            sh """#!/bin/bash
                            ./src/functions/git_clone.sh
                            tree ${env.WORKSPACE}
                            """
                        }
                    }

                    withEnv([
                        "PUBLISH_PREFIX_PATH=${env.WORKSPACE}/bootstrap_section",
                        "GIT_URL=${env.MAVEN_SIMPLE_API_REPO_URL}",
                        "PIPELINE_NAME=${env.JOB_NAME}",
                        "BUILD_NUMBER=${env.BUILD_NUMBER}",
                        "IS_IMAGE_TAG_BASED_ON_ENV=false"
                    ]) {
                        dir('one-press-bash') {
                            sh """#!/bin/bash
                            ./src/functions/write_diary.sh
                            """
                        }
                    }

                    archiveArtifacts artifacts: "bootstrap_section/publish.json", fingerprint: true
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    withEnv([
                        'STAGE_NAME=BUILD',
                        "BUILD_BASE_DIR=${env.WORKSPACE}",
                    ]) {
                        dir('one-press-bash') {
                            sh './src/functions/initialize_workspace.sh'
                        }
                    }

                    withEnv([
                        "APP_SOURCE_BASE_DIR=${env.WORKSPACE}",
                    ]) {
                        dir('one-press-bash') {
                            sh """#!/bin/bash
                            ./src/functions/global_env_var_manager.sh
                            activate_env_vars
                            cp -r ${env.APP_SOURCE_BASE_DIR}/app_source \${FLOW_BUILD_APP_DIR}
                            """
                        }
                    }

                    withEnv([
                        "APP_SOURCE_BASE_DIR=${env.WORKSPACE}",
                        "TARGET_SUB_DIR=",
                        "TARGET_BUILD_APP=",
                        "TARGET_BUILD_OUTPUT=target/*.jar",
                        "TARGET_PLATFORM=MAVEN"
                    ]) {
                        dir('one-press-bash') {
                            sh """
                            #!/bin/bash
                            set -e
                            ls -la
                            cat ${env.GLOBAL_ENV_VAR_DIR}/.env
                            cp -r ${env.APP_SOURCE_BASE_DIR}/app_source \${FLOW_BUILD_APP_DIR}
                            ./src/functions/compile_platform.sh
                            """
                        }
                    }

                    withEnv([
                        "APP_SOURCE_BASE_DIR=${env.WORKSPACE}",
                        "TARGET_SUB_DIR=",
                        "TARGET_BUILD_APP=",
                        "TARGET_BUILD_OUTPUT=target/*.jar",
                        "TARGET_PLATFORM=MAVEN"
                    ]) {
                        dir('one-press-bash') {
                            sh """
                            #!/bin/bash
                            set -e
                            ls -la
                            chmod +x ${env.GLOBAL_ENV_VAR_DIR}/.env
                            source ${env.GLOBAL_ENV_VAR_DIR}/.env
                            cp -r ${env.APP_SOURCE_BASE_DIR}/app_source \${FLOW_BUILD_APP_DIR}

                            ./src/functions/compile_platform.sh
                            """
                        }
                    }

                    withEnv([
                        "APP_SOURCE_BASE_DIR=${env.WORKSPACE}",
                        "TARGET_SUB_DIR=",
                        "TARGET_BUILD_APP=",
                        "TARGET_BUILD_OUTPUT=target/*.jar",
                        "TARGET_PLATFORM=MAVEN"
                    ]) {
                        dir('one-press-bash') {
                            sh """
                            #!/bin/bash
                            set -e
                            ls -la
                            chmod +x ${env.GLOBAL_ENV_VAR_DIR}/.env
                            source ${env.GLOBAL_ENV_VAR_DIR}/.env
                            cp -r ${env.APP_SOURCE_BASE_DIR}/app_source \${FLOW_BUILD_APP_DIR}

                            ./src/functions/compile_platform.sh
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs(cleanWhenNotBuilt: true,
                    deleteDirs: true,
                    disableDeferredWipeout: true,
                    notFailBuild: false)
        }
    }
}
